# Docker Compose reads this file when copied to .env.
# The Windows launcher generates a random database password when .env does not
# exist. Do not copy this file first if you want that automatic setup.

# Required: use a long random hexadecimal value. Preserve the existing value
# during upgrades. Changing this variable does not rotate the database password.
NDA_DB_PASSWORD=replace-with-a-long-random-hexadecimal-password

# Published local application port. PostgreSQL uses a separate local port, 5433.
NDA_PORT=5183

# Optional: leave blank to run without outgoing email.
BREVO_API_KEY=

# Optional server-side fallback; the saved Settings sender takes priority.
BREVO_SENDER_EMAIL=
