{
  "name": "nda-tracking-dashboard",
  "version": "0.2.0-beta.1",
  "private": true,
  "engines": { "node": ">=24.11.0" },
  "type": "module",
  "description": "Contract preparation and NDA tracking workspace with versioned Word/PDF generation, signed copies, Excel workflows and Brevo reminders.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiebin-bit/nda-tracking-dashboard.git"
  },
  "homepage": "https://github.com/shiebin-bit/nda-tracking-dashboard#readme",
  "bugs": {
    "url": "https://github.com/shiebin-bit/nda-tracking-dashboard/issues"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "db:import-xlsx": "node dist/server/server/import-xlsx.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "npm run build && electron .",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:pack": "npm run build && electron-builder --win --x64 --dir",
    "desktop:dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "busboy": "^1.6.0",
    "docxtemplater": "^3.71.1",
    "exceljs": "4.4.0",
    "lucide-react": "0.468.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pizzip": "^3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "main": "desktop/main.cjs",
  "author": {
    "name": "shiebin-bit"
  }
}
