{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "types": ["node"],
    "noEmit": false
  },
  "include": ["server/**/*.ts", "src/backup-types.ts", "src/core.ts", "src/contract-core.ts", "src/contract-types.ts", "src/recycle-types.ts", "src/email-types.ts", "src/importer.ts"],
  "exclude": ["server/**/*.test.ts"]
}
